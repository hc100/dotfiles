# Claude Code を Amazon Bedrock で動かすための環境変数（テンプレート）。
# このファイルを ~/.config/bedrock/env.sh にコピーし、実値を設定して使う。
# 実ファイルは ARN(アカウントID含む)等の秘匿値を含むため git 管理しないこと。
# claude-bedrock ラッパーと、herdr 起動関数(zsh.nix)から source される。
# 注意: source 専用。ここで exec/コマンド実行はしない。

export AWS_PROFILE=your-aws-profile
export AWS_REGION=ap-northeast-1
export CLAUDE_CODE_USE_BEDROCK=1

# モデルは Bedrock の application-inference-profile ARN を指定する。
# 000000000000 はアカウントID、末尾は各モデルの profile id に置き換える。
export ANTHROPIC_DEFAULT_HAIKU_MODEL=arn:aws:bedrock:ap-northeast-1:000000000000:application-inference-profile/REPLACE_ME_HAIKU
export ANTHROPIC_DEFAULT_SONNET_MODEL=arn:aws:bedrock:ap-northeast-1:000000000000:application-inference-profile/REPLACE_ME_SONNET
export ANTHROPIC_DEFAULT_OPUS_MODEL=arn:aws:bedrock:ap-northeast-1:000000000000:application-inference-profile/REPLACE_ME_OPUS
export HAIKU_ARN="$ANTHROPIC_DEFAULT_HAIKU_MODEL"
export SONNET_ARN="$ANTHROPIC_DEFAULT_SONNET_MODEL"
export OPUS_ARN="$ANTHROPIC_DEFAULT_OPUS_MODEL"
